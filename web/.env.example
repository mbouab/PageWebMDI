# Production domain used for absolute URLs (Open Graph images, sitemap.xml,
# robots.txt). Falls back to http://localhost:3000 when unset.
# See TODO_MEHDI.md — domaine de production à confirmer.
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery (Resend). Without RESEND_API_KEY, the app
# falls back to logging the message to the console instead of crashing (T-9.4).
# See TODO_MEHDI.md — email de contact / inbox à confirmer.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_INBOX=
